{
  "rules": {
    "households": {
      "$householdId": {
        // Baca: anggota household yang tidak dikeluarkan, atau owner.
        ".read": "auth != null && ((root.child('households').child($householdId).child('members').child(auth.uid).exists() && root.child('households').child($householdId).child('members').child(auth.uid).child('removed').val() !== true) || root.child('households').child($householdId).child('owner').val() === auth.uid)",

        // Tulis:
        // 1. Household baru: pencipta menjadi owner.
        // 2. Owner: boleh menulis seluruh node.
        // 3. Anggota: hanya boleh menulis jika kolom non-data (owner, members, settings, inviteCode) tidak berubah.
        ".write": "auth != null && (
          (!data.exists() && newData.child('owner').val() === auth.uid) ||
          (root.child('households').child($householdId).child('owner').val() === auth.uid) ||
          (
            root.child('households').child($householdId).child('members').child(auth.uid).exists() &&
            root.child('households').child($householdId).child('members').child(auth.uid).child('removed').val() !== true &&
            data.exists() &&
            newData.child('owner').val() === data.child('owner').val() &&
            newData.child('members').val() === data.child('members').val() &&
            newData.child('settings').val() === data.child('settings').val() &&
            newData.child('inviteCode').val() === data.child('inviteCode').val()
          )
        )",

        // Validasi struktur envelope saat tulis.
        ".validate": "newData.isObject() && newData.hasChildren(['app', 'schemaVersion', 'data', 'revision', 'savedAt'])",

        "owner": {
          ".validate": "newData.isString() && newData.val().length > 0",
          ".write": "auth != null && root.child('households').child($householdId).child('owner').val() === auth.uid"
        },

        "members": {
          "$uid": {
            ".validate": "newData.isObject() && newData.hasChildren(['name', 'email', 'role', 'joinedAt'])",
            ".write": "auth != null && (root.child('households').child($householdId).child('owner').val() === auth.uid || (auth.uid === $uid && !data.exists() && !newData.exists()))"
          }
        },

        "data": {
          ".validate": "newData.isObject() && newData.hasChildren(['users', 'accounts', 'categories', 'transactions', 'settings'])",
          // Anggota dapat menulis data transaksi mereka sendiri.
          ".write": "auth != null && root.child('households').child($householdId).child('members').child(auth.uid).exists() && root.child('households').child($householdId).child('members').child(auth.uid).child('removed').val() !== true"
        },

        "settings": {
          ".validate": "newData.isObject()",
          // Hanya owner yang mengubah pengaturan.
          ".write": "auth != null && root.child('households').child($householdId).child('owner').val() === auth.uid"
        },

        "inviteCode": {
          ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 8",
          // Hanya owner yang mengubah kode undangan.
          ".write": "auth != null && root.child('households').child($householdId).child('owner').val() === auth.uid"
        },

        "conflicts": {
          ".validate": "newData.isObject()",
          "$conflictId": {
            ".validate": "newData.isObject() && newData.hasChildren(['key', 'localValue', 'remoteValue', 'resolved', 'createdAt'])",
            ".write": "auth != null && root.child('households').child($householdId).child('owner').val() === auth.uid",
            ".read": "auth != null && ((root.child('households').child($householdId).child('members').child(auth.uid).exists() && root.child('households').child($householdId).child('members').child(auth.uid).child('removed').val() !== true) || root.child('households').child($householdId).child('owner').val() === auth.uid)"
          }
        }
      }
    },

    "oauth_relay": {
      ".read": false,
      ".write": false
    },

    "inviteCodes": {
      "$code": {
        // Baca kode undangan: hanya jika belum kedaluwarsa (expelsAt > now).
        ".read": "auth != null && data.child('expiresAt').val() > now",

        // Tulis: hanya owner household yang membuat kode, dengan masa berlaku di masa depan.
        ".write": "auth != null && newData.child('ownerUid').val() && root.child('households').child(newData.child('ownerUid').val()).child('owner').val() === auth.uid && newData.child('expiresAt').val() > now",

        ".validate": "newData.isObject() && newData.hasChildren(['ownerUid', 'householdName', 'updatedAt', 'expiresAt'])"
      }
    }
  }
}
