{
  "rules": {
    "households": {
      "$householdId": {
        // Baca: Anggota household yang tidak dikeluarkan, atau owner.
        ".read": "auth != null && ((root.child('households').child($householdId).child('members').child(auth.uid).exists() && root.child('households').child($householdId).child('members').child(auth.uid).child('removed').val() !== true) || root.child('households').child($householdId).child('owner').val() === auth.uid)",

        // Tulis Root (Sync Envelope):
        // 1. Household baru: pencipta menjadi owner.
        // 2. Owner: boleh menulis seluruh node.
        // 3. Anggota aktif: boleh menulis jika owner, settings, dan inviteCode tidak dimodifikasi secara ilegal (opsional dalam PATCH).
        ".write": "auth != null && (
          (!data.exists() && newData.child('owner').val() === auth.uid) ||
          (data.child('owner').val() === auth.uid) ||
          (
            root.child('households').child($householdId).child('members').child(auth.uid).exists() &&
            root.child('households').child($householdId).child('members').child(auth.uid).child('removed').val() !== true &&
            data.exists() &&
            (!newData.child('owner').exists() || newData.child('owner').val() === data.child('owner').val()) &&
            (!newData.child('settings').exists() || newData.child('settings').val() === data.child('settings').val()) &&
            (!newData.child('inviteCode').exists() || newData.child('inviteCode').val() === data.child('inviteCode').val())
          )
        )",

        // Validasi struktur envelope saat tulis.
        ".validate": "newData.hasChildren(['app', 'schemaVersion', 'data', 'revision', 'savedAt'])",

        "owner": {
          ".validate": "newData.isString() && newData.val().length > 0",
          // Izinkan jika: tidak dikirim (PATCH parsial), ATAU pembuatan baru (!data.exists()), ATAU ditulis oleh Owner asli.
          ".write": "auth != null && (!newData.exists() || !data.exists() || data.val() === auth.uid)"
        },

        "members": {
          "$uid": {
            ".validate": "newData.hasChildren(['name', 'email', 'role', 'joinedAt'])",
            // Owner boleh menulis semua node anggota. Calon anggota hanya boleh mendaftarkan dirinya saat pertama bergabung.
            ".write": "auth != null && (root.child('households').child($householdId).child('owner').val() === auth.uid || (auth.uid === $uid && !data.exists() && newData.exists() && root.child('households').child($householdId).child('owner').exists() && newData.child('role').val() === 'member'))"
          }
        },

        "data": {
          ".validate": "newData.hasChildren(['users', 'accounts', 'categories', 'transactions', 'settings'])",
          // Anggota aktif dan owner dapat memperbarui data transaksi/kategori/akun.
          ".write": "auth != null && ((root.child('households').child($householdId).child('members').child(auth.uid).exists() && root.child('households').child($householdId).child('members').child(auth.uid).child('removed').val() !== true) || root.child('households').child($householdId).child('owner').val() === auth.uid)"
        },

        "settings": {
          ".validate": "newData.exists()",
          // Hanya owner yang boleh mengubah pengaturan. Izinkan jika node tidak dikirim (!newData.exists()).
          ".write": "auth != null && (!newData.exists() || root.child('households').child($householdId).child('owner').val() === auth.uid)"
        },

        "inviteCode": {
          ".validate": "newData.isString() && newData.val().length >= 4 && newData.val().length <= 8",
          // Hanya owner yang boleh mengubah kode undangan. Izinkan jika node tidak dikirim (!newData.exists()).
          ".write": "auth != null && (!newData.exists() || root.child('households').child($householdId).child('owner').val() === auth.uid)"
        },

        "conflicts": {
          ".validate": "newData.exists()",
          "$conflictId": {
            ".validate": "newData.hasChildren(['key', 'localValue', 'remoteValue', 'resolved', 'createdAt'])",
            ".write": "auth != null && root.child('households').child($householdId).child('owner').val() === auth.uid",
            ".read": "auth != null && ((root.child('households').child($householdId).child('members').child(auth.uid).exists() && root.child('households').child($householdId).child('members').child(auth.uid).child('removed').val() !== true) || root.child('households').child($householdId).child('owner').val() === auth.uid)"
          }
        }
      }
    },

    "oauth_relay": {
      ".read": false,
      ".write": false
    },

    "inviteCodes": {
      "$code": {
        ".read": "auth != null && data.child('expiresAt').val() > now",
        ".write": "auth != null && newData.child('ownerUid').exists() && root.child('households').child(newData.child('ownerUid').val()).child('owner').val() === auth.uid && newData.child('expiresAt').val() > now",
        ".validate": "newData.hasChildren(['ownerUid', 'householdName', 'updatedAt', 'expiresAt'])"
      }
    },

    "userHouseholds": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['householdUid'])"
      }
    }
  }
}
